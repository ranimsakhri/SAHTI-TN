<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Image de fond pleine opacité (comme la page de connexion) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_sahti"
        android:scaleType="fitXY"
        android:alpha="1"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Bouton retour dans une pastille claire -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="#CCFFF8EE"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Retour"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Carte du formulaire semi-transparente -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#E0FFF8EE"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="Ajouter un repas 🍽️"
                        android:textColor="#1E4D3A"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Enregistre ce que tu as mangé aujourd'hui."
                        android:textColor="#777777"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Type de repas *"
                        android:textColor="#1E4D3A"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#EAF3E8"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <Spinner
                                android:id="@+id/spinnerTypeRepas"
                                android:layout_width="match_parent"
                                android:layout_height="55dp"
                                android:background="@android:color/transparent"
                                android:padding="10dp" />

                            <!-- Flèche visuelle (ne capte pas les clics) -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="16dp"
                                android:text="▾"
                                android:textColor="#1E4D3A"
                                android:textSize="18sp"
                                android:importantForAccessibility="no" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Choisir un aliment *"
                        android:textColor="#1E4D3A"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#EAF3E8"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <Spinner
                                android:id="@+id/spinnerAliment"
                                android:layout_width="match_parent"
                                android:layout_height="55dp"
                                android:background="@android:color/transparent"
                                android:padding="10dp" />

                            <!-- Flèche visuelle (ne capte pas les clics) -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="16dp"
                                android:text="▾"
                                android:textColor="#1E4D3A"
                                android:textSize="18sp"
                                android:importantForAccessibility="no" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Quantité (grammes) *"
                        android:textColor="#1E4D3A"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <EditText
                            android:id="@+id/etQuantite"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:background="@android:color/transparent"
                            android:hint="Ex : 200"
                            android:inputType="numberDecimal"
                            android:padding="12dp"
                            android:textColor="#020202" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:cardBackgroundColor="#EAF3E8"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvCaloriesEstimees"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:text="Calories estimées : 0 kcal"
                            android:textColor="#1E4D3A"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                    <Button
                        android:id="@+id/btnEnregistrerRepas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:minHeight="55dp"
                        android:backgroundTint="#1E4D3A"
                        android:text="Enregistrer le repas"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="14dp" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Espace flexible du bas : laisse apparaître le décor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>