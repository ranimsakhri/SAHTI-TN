<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#75A77A">

    <!-- Illustration posée sur la couleur de fond (comme MainActivity) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_sahti"
        android:scaleType="fitXY"
        android:alpha="0.45"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="25dp"
            android:gravity="center_horizontal">

            <!-- Flèche retour -->
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="← Retour"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="start"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Retour à l'accueil"
                android:shadowColor="#66263B2B"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <!-- Logo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:cardBackgroundColor="#315B41"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:padding="16dp"
                    android:src="@drawable/logo_sahti"
                    android:scaleType="fitCenter"
                    android:contentDescription="Logo SA7TI TN" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Titre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Créer un compte"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="30dp"
                android:shadowColor="#66263B2B"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenue dans la communauté SAHTI !"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="25dp"
                android:shadowColor="#66263B2B"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <!-- Nom -->
            <EditText
                android:id="@+id/etNom"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_card"
                android:hint="Nom*"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:textColor="#0B0505" />

            <!-- Prénom -->
            <EditText
                android:id="@+id/etPrenom"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:hint="Prénom*"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:textColor="#0F0808" />

            <!-- Email -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:hint="Adresse e-mail*"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="#0D0606" />

            <!-- Mot de passe avec œil -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Mot de passe*"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:endIconTint="#263B2B">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:inputType="textPassword"
                    android:textColor="#100A0A" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirmation mot de passe avec œil -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Confirmer le mot de passe*"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:endIconTint="#263B2B">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:inputType="textPassword"
                    android:textColor="#100A0A" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bouton inscription -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Créer mon compte"
                android:textColor="#263B2B"
                android:textStyle="bold"
                android:backgroundTint="#FFE17A"
                android:layout_marginTop="25dp"/>

            <!-- Lien connexion -->
            <TextView
                android:id="@+id/txtGoLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Déjà inscrit(e) ? Se connecter"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:padding="15dp"
                android:layout_marginTop="10dp"
                android:shadowColor="#66263B2B"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>